# Copy to .env (docker compose loads it automatically) and fill in.
#
# Dev (docker-compose.yml) only really needs DXSPIDER_LOGIN.
# Prod (docker-compose.prod.yml) requires DXSPIDER_LOGIN too.

# Callsign used to log into the DX Spider node.
DXSPIDER_LOGIN=YOURCALL

# Comma-separated, priority-ordered DX Spider node list (optional — see
# dxspider-bridge/bridge.py for the built-in default list).
#DXSPIDER_NODES=dxspider.co.uk:7300,dx.n8noe.us:7373

# --- Production only (docker-compose.prod.yml) ---

# There's no TLS/edge proxy in the stack itself — frontend binds to
# 127.0.0.1:$SKYWAVE_PORT and expects your own host-level reverse proxy
# (nginx, Caddy, etc.) to terminate HTTPS and forward to it. Defaults to
# 8080; only change if that port's taken.
#SKYWAVE_PORT=8080

# Registry owner + tag published by .github/workflows/docker-publish.yml.
# Defaults match this repo — override if you forked it or want to pin a
# specific version (e.g. a git-tag release) instead of latest.
#GHCR_OWNER=d3mocide
#IMAGE_TAG=latest
