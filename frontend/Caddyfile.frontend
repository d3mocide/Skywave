# Static file server for the built PWA (fronted by the main Caddy instance).
:80 {
	root * /usr/share/caddy
	encode gzip zstd
	try_files {path} /index.html
	file_server
	# Service worker must never be cached hard
	header /sw.js Cache-Control "no-cache"
	header /registerSW.js Cache-Control "no-cache"
}
