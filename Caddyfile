# Skywave reverse proxy. Set SITE_ADDRESS (see .env.example) to your
# hostname to get automatic HTTPS (e.g. "skywave.example.com"); defaults to
# plain HTTP on :80 for local/dev use.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Monthly ionospheric data files — immutable per month, cache hard
	handle_path /data/* {
		root * /srv/ionos
		file_server
		header Cache-Control "public, max-age=86400, immutable"
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
